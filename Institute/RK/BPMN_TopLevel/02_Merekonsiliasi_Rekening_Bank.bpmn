<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TopLevel_REK" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- DIAGRAM TOP-LEVEL 2: Merekonsiliasi Rekening Bank — memakai ulang draf 03_Reconciliation dan panggilan entri/koreksi/impor dari Diagram 1. Jejak: BR-05; langkah D. -->
  <bpmn:collaboration id="Collab_REK">
    <bpmn:participant id="Pool_REK_Bank" name="Bank" processRef="Process_REK_Bank" />
    <bpmn:participant id="Pool_REK_Main" name="Proses Rekonsiliasi Bank" processRef="Process_REK" />
    <bpmn:messageFlow id="MF_REK_Stmt" sourceRef="Throw_REK_Stmt" targetRef="Start_REK" name="Laporan bank (mutasi dan saldo akhir)" />
  </bpmn:collaboration>
  <bpmn:process id="Process_REK_Bank" name="Laporan Bank" isExecutable="false">
    <bpmn:documentation>Bank menerbitkan dan mengirim laporan bank.</bpmn:documentation>
    <bpmn:startEvent id="Start_REK_Bank" name="Bank menerbitkan laporan">
      <bpmn:outgoing>Flow_REK_B_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Throw_REK_Stmt" name="Mengirim laporan bank">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>Flow_REK_B_S</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_B_E</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_REK_Bank" name="Laporan bank terkirim">
      <bpmn:incoming>Flow_REK_B_E</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_REK_B_S" sourceRef="Start_REK_Bank" targetRef="Throw_REK_Stmt" />
    <bpmn:sequenceFlow id="Flow_REK_B_E" sourceRef="Throw_REK_Stmt" targetRef="End_REK_Bank" />
  </bpmn:process>
  <bpmn:process id="Process_REK" name="Merekonsiliasi Rekening Bank" isExecutable="false">
    <bpmn:documentation>Tujuan: aktivitas GnuCash satu periode laporan sesuai dengan laporan bank; selisih tak jelas nol. Pemicu: laporan bank tersedia. Prasyarat: akun dan transaksi ada; tanggal dan saldo akhir laporan diketahui. Akhir: rekonsiliasi dituntaskan dengan selisih nol, atau dijeda/dibatalkan bila selisih belum terjelaskan. Penyelesaian hanya menandai splits terpilih sebagai direkonsiliasi. Jejak: 03; BR-05; langkah D.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_REK">
      <bpmn:lane id="Lane_REK_User" name="Pengguna">
        <bpmn:flowNodeRef>Start_REK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_REK_Selisih</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_REK_Sukses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_REK_Opsi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_REK_Perbaiki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_REK_Tunda</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_REK_GC" name="GnuCash">
        <bpmn:flowNodeRef>Task_REK_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_REK_T6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_REK" name="Menerima laporan bank">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>Flow_REK_S_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_REK_T1" name="Memilih akun, tanggal dan saldo akhir laporan">
      <bpmn:incoming>Flow_REK_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_REK_T2" name="Sistem menampilkan pos belum rekonsiliasi dan selisih awal">
      <bpmn:incoming>Flow_REK_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T2_T3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_REK_T3" name="Menandai transaksi yang cocok dengan laporan">
      <bpmn:incoming>Flow_REK_T2_T3</bpmn:incoming>
      <bpmn:incoming>Flow_REK_Opsi_Ubah</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T3_T4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_REK_T4" name="Sistem menghitung ulang selisih">
      <bpmn:incoming>Flow_REK_T3_T4</bpmn:incoming>
      <bpmn:incoming>Flow_REK_Perbaiki_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T4_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_REK_Selisih" name="Selisih = 0?">
      <bpmn:incoming>Flow_REK_T4_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_REK_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_REK_T5" name="Menyelesaikan rekonsiliasi">
      <bpmn:incoming>Flow_REK_Gw_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T5_T6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_REK_T6" name="Sistem menandai splits terpilih sebagai direkonsiliasi">
      <bpmn:incoming>Flow_REK_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T6_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_REK_Sukses" name="Rekonsiliasi selesai (selisih nol)">
      <bpmn:incoming>Flow_REK_T6_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_REK_T7" name="Membandingkan laporan dan buku besar, mencari selisih">
      <bpmn:incoming>Flow_REK_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_T7_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_REK_Opsi" name="Tindak lanjut selisih?">
      <bpmn:incoming>Flow_REK_T7_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_Opsi_Perbaiki</bpmn:outgoing>
      <bpmn:outgoing>Flow_REK_Opsi_Ubah</bpmn:outgoing>
      <bpmn:outgoing>Flow_REK_Opsi_Jeda</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_REK_Perbaiki" name="Subproses: entri/koreksi/impor transaksi terkait">
      <bpmn:documentation>Memakai ulang Diagram 1 (draf 02/08): mencatat biaya bank yang hilang, membetulkan jumlah/tanggal, mengubah pilihan tanda, atau mengimpor; lalu menghitung ulang selisih.</bpmn:documentation>
      <bpmn:incoming>Flow_REK_Opsi_Perbaiki</bpmn:incoming>
      <bpmn:outgoing>Flow_REK_Perbaiki_T4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_REK_Tunda" name="Dijeda atau dibatalkan (selisih belum nol)">
      <bpmn:incoming>Flow_REK_Opsi_Jeda</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="Data_REK_Stmt" name="Laporan bank" />
    <bpmn:dataObject id="Data_REK_Tgl" name="Tanggal dan saldo akhir laporan" />
    <bpmn:dataObject id="Data_REK_Selisih" name="Splits terpilih dan selisih" />
    <bpmn:dataObjectReference id="DataRef_REK_Stmt" name="Laporan bank" dataObjectRef="Data_REK_Stmt" />
    <bpmn:dataObjectReference id="DataRef_REK_Tgl" name="Tanggal dan saldo akhir laporan" dataObjectRef="Data_REK_Tgl" />
    <bpmn:dataObjectReference id="DataRef_REK_Selisih" name="Splits terpilih dan selisih" dataObjectRef="Data_REK_Selisih" />
    <bpmn:textAnnotation id="Ann_REK_Nol">
      <bpmn:text>Selesai hanya saat selisih nol; splits terpilih ditandai direkonsiliasi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_REK_S_T1" sourceRef="Start_REK" targetRef="Task_REK_T1" />
    <bpmn:sequenceFlow id="Flow_REK_T1_T2" sourceRef="Task_REK_T1" targetRef="Task_REK_T2" />
    <bpmn:sequenceFlow id="Flow_REK_T2_T3" sourceRef="Task_REK_T2" targetRef="Task_REK_T3" />
    <bpmn:sequenceFlow id="Flow_REK_T3_T4" sourceRef="Task_REK_T3" targetRef="Task_REK_T4" />
    <bpmn:sequenceFlow id="Flow_REK_T4_Gw" sourceRef="Task_REK_T4" targetRef="Gw_REK_Selisih" />
    <bpmn:sequenceFlow id="Flow_REK_Gw_Ya" sourceRef="Gw_REK_Selisih" targetRef="Task_REK_T5" name="Ya" />
    <bpmn:sequenceFlow id="Flow_REK_T5_T6" sourceRef="Task_REK_T5" targetRef="Task_REK_T6" />
    <bpmn:sequenceFlow id="Flow_REK_T6_End" sourceRef="Task_REK_T6" targetRef="End_REK_Sukses" />
    <bpmn:sequenceFlow id="Flow_REK_Gw_Tidak" sourceRef="Gw_REK_Selisih" targetRef="Task_REK_T7" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_REK_T7_Gw" sourceRef="Task_REK_T7" targetRef="Gw_REK_Opsi" />
    <bpmn:sequenceFlow id="Flow_REK_Opsi_Perbaiki" sourceRef="Gw_REK_Opsi" targetRef="Sub_REK_Perbaiki" name="Perbaiki atau entri" />
    <bpmn:sequenceFlow id="Flow_REK_Opsi_Ubah" sourceRef="Gw_REK_Opsi" targetRef="Task_REK_T3" name="Ubah pilihan tanda" />
    <bpmn:sequenceFlow id="Flow_REK_Opsi_Jeda" sourceRef="Gw_REK_Opsi" targetRef="End_REK_Tunda" name="Jeda" />
    <bpmn:sequenceFlow id="Flow_REK_Perbaiki_T4" sourceRef="Sub_REK_Perbaiki" targetRef="Task_REK_T4" />
    <bpmn:association id="Assoc_REK_Stmt" sourceRef="Task_REK_T3" targetRef="DataRef_REK_Stmt" />
    <bpmn:association id="Assoc_REK_Tgl" sourceRef="Task_REK_T1" targetRef="DataRef_REK_Tgl" />
    <bpmn:association id="Assoc_REK_Selisih" sourceRef="Task_REK_T4" targetRef="DataRef_REK_Selisih" />
    <bpmn:association id="Assoc_REK_Ann" sourceRef="Task_REK_T6" targetRef="Ann_REK_Nol" />
  </bpmn:process>
