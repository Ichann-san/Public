<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TopLevel_EVA" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- DIAGRAM TOP-LEVEL 3: Merencanakan dan Mengevaluasi Keuangan — memakai ulang draf 06_Budgeting dan 07_FinancialReports. Jejak: BR-03, BR-04; langkah E, G. -->
  <bpmn:collaboration id="Collab_EVA">
    <bpmn:participant id="Pool_EVA_Main" name="Proses Perencanaan dan Evaluasi" processRef="Process_EVA" />
  </bpmn:collaboration>
  <bpmn:process id="Process_EVA" name="Merencanakan dan Mengevaluasi Keuangan" isExecutable="false">
    <bpmn:documentation>Tujuan: pengguna menetapkan jumlah anggaran, membandingkan realisasi, dan memeriksa/membagikan laporan keuangan; satu siklus keputusan berulang. Pemicu: periode perencanaan baru atau tanggal tinjauan. Prasyarat: akun relevan ada; perbandingan aktual butuh transaksi tercatat. Akhir: anggaran tersimpan dan situasi keuangan ditinjau; laporan opsional disimpan/dicetak/dibagikan pengguna. Keputusan korektif bisnis (di luar GnuCash) tetap tugas pengguna. Jejak: 06, 07; BR-03, BR-04.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_EVA">
      <bpmn:lane id="Lane_EVA_User" name="Pengguna">
        <bpmn:flowNodeRef>Start_EVA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Lanjut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EVA_Batal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Jalur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Cukup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Siklus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EVA_Anggaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Layak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Arah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_EVA_Koreksi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Revisi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EVA_Bagi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EVA_Sukses</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EVA_GC" name="GnuCash">
        <bpmn:flowNodeRef>Task_EVA_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EVA_T5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_EVA" name="Periode perencanaan atau tinjauan tiba">
      <bpmn:outgoing>Flow_EVA_S_Gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_EVA_Lanjut" name="Lanjutkan perencanaan?">
      <bpmn:incoming>Flow_EVA_S_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Lanjut_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Lanjut_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_EVA_Batal" name="Dibatalkan (tanpa perubahan)">
      <bpmn:incoming>Flow_EVA_Lanjut_Tidak</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_EVA_Jalur" name="Mulai dari?">
      <bpmn:incoming>Flow_EVA_Lanjut_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Jalur_Anggaran</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Jalur_Tinjau</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EVA_T1" name="Memilih periode dan akun anggaran (boleh sebagian)">
      <bpmn:incoming>Flow_EVA_Jalur_Anggaran</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EVA_T2" name="Mengisi jumlah anggaran per periode">
      <bpmn:incoming>Flow_EVA_T1_T2</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_Cukup_Tidak</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_Revisi_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T2_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_EVA_Cukup" name="Anggaran cukup jelas untuk disimpan?">
      <bpmn:incoming>Flow_EVA_T2_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Cukup_Tidak</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Cukup_Ya</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_EVA_T3" name="Sistem menyimpan anggaran">
      <bpmn:incoming>Flow_EVA_Cukup_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T3_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_EVA_Siklus" name="Lanjut ke tinjauan sekarang?">
      <bpmn:incoming>Flow_EVA_T3_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Siklus_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Siklus_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_EVA_Anggaran" name="Anggaran tersimpan (belum ditinjau)">
      <bpmn:incoming>Flow_EVA_Siklus_Tidak</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_EVA_T4" name="Membuka budget-vs-aktual; memilih jenis, tanggal dan opsi">
      <bpmn:incoming>Flow_EVA_Jalur_Tinjau</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_Siklus_Ya</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_Arah_Filter</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T4_T5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_EVA_T5" name="Sistem menghitung dari buku besar dan merender hasil">
      <bpmn:incoming>Flow_EVA_T4_T5</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_Koreksi_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T5_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_EVA_Layak" name="Data dan opsi sudah tepat?">
      <bpmn:incoming>Flow_EVA_T5_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Layak_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Layak_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_EVA_Arah" name="Perbaiki melalui?">
      <bpmn:incoming>Flow_EVA_Layak_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Arah_Filter</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Arah_Data</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_EVA_Koreksi" name="Subproses: koreksi data buku besar">
      <bpmn:documentation>Memakai ulang Diagram 1 (draf 01/02): memilih atau membuat akun, mencatat atau mengoreksi transaksi, lalu menghitung ulang.</bpmn:documentation>
      <bpmn:incoming>Flow_EVA_Arah_Data</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Koreksi_T5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_EVA_T6" name="Menilai selisih dan memutuskan tindak lanjut (di luar GnuCash)">
      <bpmn:incoming>Flow_EVA_Layak_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T6_Gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_EVA_Revisi" name="Revisi anggaran?">
      <bpmn:incoming>Flow_EVA_T6_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Revisi_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Revisi_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_EVA_Bagi" name="Simpan, cetak, atau ekspor laporan?">
      <bpmn:incoming>Flow_EVA_Revisi_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_Bagi_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_EVA_Bagi_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EVA_T7" name="Menyimpan, mencetak, atau mengekspor (opsi yang didukung)">
      <bpmn:incoming>Flow_EVA_Bagi_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_EVA_T7_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_EVA_Sukses" name="Rencana ditinjau dan laporan siap">
      <bpmn:incoming>Flow_EVA_Bagi_Tidak</bpmn:incoming>
      <bpmn:incoming>Flow_EVA_T7_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="Data_EVA_Anggaran" name="Periode, akun dan jumlah anggaran" />
    <bpmn:dataObject id="Data_EVA_Aktual" name="Transaksi aktual buku besar" />
    <bpmn:dataObject id="Data_EVA_Opsi" name="Jenis, tanggal, opsi dan output laporan" />
    <bpmn:dataObjectReference id="DataRef_EVA_Anggaran" name="Periode, akun dan jumlah anggaran" dataObjectRef="Data_EVA_Anggaran" />
    <bpmn:dataObjectReference id="DataRef_EVA_Aktual" name="Transaksi aktual buku besar" dataObjectRef="Data_EVA_Aktual" />
    <bpmn:dataObjectReference id="DataRef_EVA_Opsi" name="Jenis, tanggal, opsi dan output laporan" dataObjectRef="Data_EVA_Opsi" />
    <bpmn:textAnnotation id="Ann_EVA_Sebagian">
      <bpmn:text>Anggaran boleh sebagian akun; keputusan korektif bisnis di luar GnuCash.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_EVA_S_Gw" sourceRef="Start_EVA" targetRef="Gw_EVA_Lanjut" />
    <bpmn:sequenceFlow id="Flow_EVA_Lanjut_Ya" sourceRef="Gw_EVA_Lanjut" targetRef="Gw_EVA_Jalur" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_Lanjut_Tidak" sourceRef="Gw_EVA_Lanjut" targetRef="End_EVA_Batal" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_Jalur_Anggaran" sourceRef="Gw_EVA_Jalur" targetRef="Task_EVA_T1" name="Anggaran" />
    <bpmn:sequenceFlow id="Flow_EVA_Jalur_Tinjau" sourceRef="Gw_EVA_Jalur" targetRef="Task_EVA_T4" name="Tinjauan" />
    <bpmn:sequenceFlow id="Flow_EVA_T1_T2" sourceRef="Task_EVA_T1" targetRef="Task_EVA_T2" />
    <bpmn:sequenceFlow id="Flow_EVA_T2_Gw" sourceRef="Task_EVA_T2" targetRef="Gw_EVA_Cukup" />
    <bpmn:sequenceFlow id="Flow_EVA_Cukup_Tidak" sourceRef="Gw_EVA_Cukup" targetRef="Task_EVA_T2" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_Cukup_Ya" sourceRef="Gw_EVA_Cukup" targetRef="Task_EVA_T3" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_T3_Gw" sourceRef="Task_EVA_T3" targetRef="Gw_EVA_Siklus" />
    <bpmn:sequenceFlow id="Flow_EVA_Siklus_Ya" sourceRef="Gw_EVA_Siklus" targetRef="Task_EVA_T4" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_Siklus_Tidak" sourceRef="Gw_EVA_Siklus" targetRef="End_EVA_Anggaran" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_T4_T5" sourceRef="Task_EVA_T4" targetRef="Task_EVA_T5" />
    <bpmn:sequenceFlow id="Flow_EVA_T5_Gw" sourceRef="Task_EVA_T5" targetRef="Gw_EVA_Layak" />
    <bpmn:sequenceFlow id="Flow_EVA_Layak_Ya" sourceRef="Gw_EVA_Layak" targetRef="Task_EVA_T6" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_Layak_Tidak" sourceRef="Gw_EVA_Layak" targetRef="Gw_EVA_Arah" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_Arah_Filter" sourceRef="Gw_EVA_Arah" targetRef="Task_EVA_T4" name="Ubah filter atau opsi" />
    <bpmn:sequenceFlow id="Flow_EVA_Arah_Data" sourceRef="Gw_EVA_Arah" targetRef="Sub_EVA_Koreksi" name="Koreksi data buku besar" />
    <bpmn:sequenceFlow id="Flow_EVA_Koreksi_T5" sourceRef="Sub_EVA_Koreksi" targetRef="Task_EVA_T5" />
    <bpmn:sequenceFlow id="Flow_EVA_T6_Gw" sourceRef="Task_EVA_T6" targetRef="Gw_EVA_Revisi" />
    <bpmn:sequenceFlow id="Flow_EVA_Revisi_Ya" sourceRef="Gw_EVA_Revisi" targetRef="Task_EVA_T2" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_Revisi_Tidak" sourceRef="Gw_EVA_Revisi" targetRef="Gw_EVA_Bagi" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_Bagi_Ya" sourceRef="Gw_EVA_Bagi" targetRef="Task_EVA_T7" name="Ya" />
    <bpmn:sequenceFlow id="Flow_EVA_Bagi_Tidak" sourceRef="Gw_EVA_Bagi" targetRef="End_EVA_Sukses" name="Tidak" />
    <bpmn:sequenceFlow id="Flow_EVA_T7_End" sourceRef="Task_EVA_T7" targetRef="End_EVA_Sukses" />
    <bpmn:association id="Assoc_EVA_Anggaran" sourceRef="Task_EVA_T2" targetRef="DataRef_EVA_Anggaran" />
    <bpmn:association id="Assoc_EVA_Aktual" sourceRef="Task_EVA_T5" targetRef="DataRef_EVA_Aktual" />
    <bpmn:association id="Assoc_EVA_Opsi" sourceRef="Task_EVA_T4" targetRef="DataRef_EVA_Opsi" />
    <bpmn:association id="Assoc_EVA_Ann" sourceRef="Task_EVA_T1" targetRef="Ann_EVA_Sebagian" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_EVA">
      <bpmndi:BPMNShape id="Lane_EVA_User_di" bpmnElement="Lane_EVA_User" isHorizontal="true">
        <dc:Bounds x="150" y="0" width="3650" height="812" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_EVA_GC_di" bpmnElement="Lane_EVA_GC" isHorizontal="true">
        <dc:Bounds x="150" y="812" width="3650" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_EVA_Main_di" bpmnElement="Pool_EVA_Main" isHorizontal="true">
        <dc:Bounds x="120" y="0" width="3680" height="1062" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_EVA_di" bpmnElement="Start_EVA">
        <dc:Bounds x="222" y="177" width="36" height="36" />
