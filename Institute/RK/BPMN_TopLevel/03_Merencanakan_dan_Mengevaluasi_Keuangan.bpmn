        <bpmndi:BPMNLabel>
          <dc:Bounds x="2156" y="903" width="128" height="58" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_EVA_Layak_di" bpmnElement="Gw_EVA_Layak" isMarkerVisible="true">
        <dc:Bounds x="2415" y="170" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2380" y="126" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_EVA_Arah_di" bpmnElement="Gw_EVA_Arah" isMarkerVisible="true">
        <dc:Bounds x="2635" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2600" y="336" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_EVA_Koreksi_di" bpmnElement="Sub_EVA_Koreksi" isExpanded="false">
        <dc:Bounds x="2810" y="365" width="140" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2816" y="371" width="128" height="58" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EVA_T6_di" bpmnElement="Task_EVA_T6">
        <dc:Bounds x="2590" y="155" width="140" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2596" y="161" width="128" height="58" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_EVA_Revisi_di" bpmnElement="Gw_EVA_Revisi" isMarkerVisible="true">
        <dc:Bounds x="2855" y="170" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2820" y="126" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_EVA_Bagi_di" bpmnElement="Gw_EVA_Bagi" isMarkerVisible="true">
