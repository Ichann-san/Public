      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_EVA_Jalur_di" bpmnElement="Gw_EVA_Jalur" isMarkerVisible="true">
        <dc:Bounds x="655" y="170" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="126" width="120" height="40" />
