<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_TransactionEntry"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- PRODUK 2: PENCATATAN TRANSAKSI (Jurnal) — 2 business processes -->

  <!-- ============ BP 2A: MENCATAT TRANSAKSI BARU ============ -->
  <bpmn:process id="Process_TransNew" name="Mencatat Transaksi Baru" isExecutable="false">
    <bpmn:documentation>Proses mencatat transaksi baru pada register GnuCash: memilih akun, mengisi rincian transaksi, menentukan akun lawan, lalu sistem memvalidasi kesimbangan dan menyimpan.</bpmn:documentation>

    <bpmn:startEvent id="Start_TransNew" name="Kebutuhan mencatat transaksi">
      <bpmn:outgoing>Flow_TN_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_TN_T1" name="Memilih akun &amp; register yang sesuai">
      <bpmn:incoming>Flow_TN_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_T1_T2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TN_T2" name="Mengisi tanggal, deskripsi, dan jumlah">
      <bpmn:incoming>Flow_TN_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_T2_T3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TN_T3" name="Menentukan akun lawan (splits)">
      <bpmn:incoming>Flow_TN_T2_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_T3_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_TN_Balance" name="Transaksi seimbang?">
      <bpmn:incoming>Flow_TN_T3_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_TN_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_TN_T4" name="Memperbaiki akun lawan / jumlah">
      <bpmn:incoming>Flow_TN_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_T4_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_TN_Simpan" name="Sistem memvalidasi &amp; menyimpan transaksi">
      <bpmn:incoming>Flow_TN_Gw_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_TN_Simpan_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_TN" name="Transaksi tercatat">
      <bpmn:incoming>Flow_TN_Simpan_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObject id="Data_TN_Akun" name="Daftar akun"/>
    <bpmn:dataObjectReference id="DataRef_TN_Akun" name="Daftar akun" dataObjectRef="Data_TN_Akun"/>

    <bpmn:sequenceFlow id="Flow_TN_S_T1" sourceRef="Start_TransNew" targetRef="Task_TN_T1"/>
    <bpmn:sequenceFlow id="Flow_TN_T1_T2" sourceRef="Task_TN_T1" targetRef="Task_TN_T2"/>
    <bpmn:sequenceFlow id="Flow_TN_T2_T3" sourceRef="Task_TN_T2" targetRef="Task_TN_T3"/>
    <bpmn:sequenceFlow id="Flow_TN_T3_Gw" sourceRef="Task_TN_T3" targetRef="Gw_TN_Balance"/>
    <bpmn:sequenceFlow id="Flow_TN_Gw_Ya" name="Ya (debit = kredit)" sourceRef="Gw_TN_Balance" targetRef="Task_TN_Simpan"/>
    <bpmn:sequenceFlow id="Flow_TN_Gw_Tidak" name="Tidak" sourceRef="Gw_TN_Balance" targetRef="Task_TN_T4"/>
    <bpmn:sequenceFlow id="Flow_TN_T4_Gw" sourceRef="Task_TN_T4" targetRef="Gw_TN_Balance"/>
    <bpmn:sequenceFlow id="Flow_TN_Simpan_End" sourceRef="Task_TN_Simpan" targetRef="End_TN"/>

    <bpmn:association id="Assoc_TN" sourceRef="Task_TN_T3" targetRef="DataRef_TN_Akun"/>
  </bpmn:process>

  <!-- ============ BP 2B: MENGOREKSI / MENGHAPUS TRANSAKSI ============ -->
  <bpmn:process id="Process_TransCorrect" name="Mengoreksi Transaksi" isExecutable="false">
    <bpmn:documentation>Proses mengoreksi atau menghapus transaksi: memilih transaksi, menentukan jenis koreksi (ubah rincian, void, atau hapus), dengan konfirmasi sebelum penghapusan.</bpmn:documentation>

    <bpmn:startEvent id="Start_TransCorrect" name="Transaksi salah ditemukan">
      <bpmn:outgoing>Flow_TC_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_TC_T1" name="Membuka register &amp; memilih transaksi">
      <bpmn:incoming>Flow_TC_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_T1_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_TC_Jenis" name="Jenis koreksi?">
      <bpmn:incoming>Flow_TC_T1_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_Gw_Ubah</bpmn:outgoing>
      <bpmn:outgoing>Flow_TC_Gw_Void</bpmn:outgoing>
      <bpmn:outgoing>Flow_TC_Gw_Hapus</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_TC_Ubah" name="Mengubah rincian transaksi">
      <bpmn:incoming>Flow_TC_Gw_Ubah</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_Ubah_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TC_Void" name="Membuat transaksi pembalik (void)">
      <bpmn:incoming>Flow_TC_Gw_Void</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_Void_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_TC_Yakin" name="Yakin menghapus?">
      <bpmn:incoming>Flow_TC_Gw_Hapus</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_Yakin_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_TC_Yakin_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_TC_Hapus" name="Sistem menghapus transaksi &amp; menyesuaikan saldo">
      <bpmn:incoming>Flow_TC_Yakin_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_TC_Hapus_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_TC_Hapus" name="Transaksi dihapus">
      <bpmn:incoming>Flow_TC_Hapus_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_TC_Batal" name="Transaksi dipertahankan">
      <bpmn:incoming>Flow_TC_Yakin_Tidak</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_TC_Ubah" name="Transaksi diperbaiki">
      <bpmn:incoming>Flow_TC_Ubah_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_TC_Void" name="Transaksi dibatalkan (void)">
      <bpmn:incoming>Flow_TC_Void_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_TC_S_T1" sourceRef="Start_TransCorrect" targetRef="Task_TC_T1"/>
    <bpmn:sequenceFlow id="Flow_TC_T1_Gw" sourceRef="Task_TC_T1" targetRef="Gw_TC_Jenis"/>
    <bpmn:sequenceFlow id="Flow_TC_Gw_Ubah" name="Ubah rincian" sourceRef="Gw_TC_Jenis" targetRef="Task_TC_Ubah"/>
    <bpmn:sequenceFlow id="Flow_TC_Gw_Void" name="Void" sourceRef="Gw_TC_Jenis" targetRef="Task_TC_Void"/>
    <bpmn:sequenceFlow id="Flow_TC_Gw_Hapus" name="Hapus" sourceRef="Gw_TC_Jenis" targetRef="Gw_TC_Yakin"/>
    <bpmn:sequenceFlow id="Flow_TC_Yakin_Ya" name="Ya" sourceRef="Gw_TC_Yakin" targetRef="Task_TC_Hapus"/>
    <bpmn:sequenceFlow id="Flow_TC_Yakin_Tidak" name="Tidak" sourceRef="Gw_TC_Yakin" targetRef="End_TC_Batal"/>
    <bpmn:sequenceFlow id="Flow_TC_Ubah_End" sourceRef="Task_TC_Ubah" targetRef="End_TC_Ubah"/>
    <bpmn:sequenceFlow id="Flow_TC_Void_End" sourceRef="Task_TC_Void" targetRef="End_TC_Void"/>
    <bpmn:sequenceFlow id="Flow_TC_Hapus_End" sourceRef="Task_TC_Hapus" targetRef="End_TC_Hapus"/>
  </bpmn:process>

  <!-- ============ DIAGRAM 2A ============ -->
  <bpmndi:BPMNDiagram id="Diagram_TransNew" name="Mencatat Transaksi Baru">
    <bpmndi:BPMNPlane id="Plane_TransNew" bpmnElement="Process_TransNew">
      <bpmndi:BPMNShape id="Start_TransNew_di" bpmnElement="Start_TransNew">
        <dc:Bounds x="402" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TN_T1_di" bpmnElement="Task_TN_T1">
        <dc:Bounds x="330" y="150" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TN_T2_di" bpmnElement="Task_TN_T2">
        <dc:Bounds x="330" y="260" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TN_T3_di" bpmnElement="Task_TN_T3">
        <dc:Bounds x="330" y="370" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TN_Balance_di" bpmnElement="Gw_TN_Balance">
        <dc:Bounds x="380" y="490" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TN_T4_di" bpmnElement="Task_TN_T4">
        <dc:Bounds x="120" y="490" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TN_Simpan_di" bpmnElement="Task_TN_Simpan">
        <dc:Bounds x="650" y="490" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TN_di" bpmnElement="End_TN">
        <dc:Bounds x="722" y="630" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataRef_TN_Akun_di" bpmnElement="DataRef_TN_Akun">
        <dc:Bounds x="120" y="370" width="100" height="60"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_TN_S_T1_di" bpmnElement="Flow_TN_S_T1">
        <di:waypoint x="420" y="116"/>
        <di:waypoint x="420" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_T1_T2_di" bpmnElement="Flow_TN_T1_T2">
        <di:waypoint x="420" y="230"/>
        <di:waypoint x="420" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_T2_T3_di" bpmnElement="Flow_TN_T2_T3">
        <di:waypoint x="420" y="340"/>
        <di:waypoint x="420" y="370"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_T3_Gw_di" bpmnElement="Flow_TN_T3_Gw">
        <di:waypoint x="420" y="450"/>
        <di:waypoint x="420" y="490"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_Gw_Ya_di" bpmnElement="Flow_TN_Gw_Ya">
        <di:waypoint x="460" y="530"/>
        <di:waypoint x="650" y="530"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="512" width="100" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_Gw_Tidak_di" bpmnElement="Flow_TN_Gw_Tidak">
        <di:waypoint x="380" y="530"/>
        <di:waypoint x="300" y="530"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="512" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_T4_Gw_di" bpmnElement="Flow_TN_T4_Gw">
        <di:waypoint x="300" y="530"/>
        <di:waypoint x="380" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TN_Simpan_End_di" bpmnElement="Flow_TN_Simpan_End">
        <di:waypoint x="740" y="570"/>
        <di:waypoint x="740" y="630"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_TN_di" bpmnElement="Assoc_TN">
        <di:waypoint x="220" y="400"/>
        <di:waypoint x="330" y="400"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- ============ DIAGRAM 2B ============ -->
  <bpmndi:BPMNDiagram id="Diagram_TransCorrect" name="Mengoreksi Transaksi">
    <bpmndi:BPMNPlane id="Plane_TransCorrect" bpmnElement="Process_TransCorrect">
      <bpmndi:BPMNShape id="Start_TransCorrect_di" bpmnElement="Start_TransCorrect">
        <dc:Bounds x="422" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TC_T1_di" bpmnElement="Task_TC_T1">
        <dc:Bounds x="350" y="150" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TC_Jenis_di" bpmnElement="Gw_TC_Jenis">
        <dc:Bounds x="400" y="310" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TC_Ubah_di" bpmnElement="Task_TC_Ubah">
        <dc:Bounds x="80" y="330" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TC_Void_di" bpmnElement="Task_TC_Void">
        <dc:Bounds x="250" y="470" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TC_Yakin_di" bpmnElement="Gw_TC_Yakin">
        <dc:Bounds x="540" y="310" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TC_Hapus_di" bpmnElement="Task_TC_Hapus">
        <dc:Bounds x="690" y="330" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TC_Ubah_di" bpmnElement="End_TC_Ubah">
        <dc:Bounds x="152" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TC_Void_di" bpmnElement="End_TC_Void">
        <dc:Bounds x="322" y="630" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TC_Hapus_di" bpmnElement="End_TC_Hapus">
        <dc:Bounds x="762" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TC_Batal_di" bpmnElement="End_TC_Batal">
        <dc:Bounds x="762" y="250" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_TC_S_T1_di" bpmnElement="Flow_TC_S_T1">
        <di:waypoint x="440" y="116"/>
        <di:waypoint x="440" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_T1_Gw_di" bpmnElement="Flow_TC_T1_Gw">
        <di:waypoint x="440" y="230"/>
        <di:waypoint x="440" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Gw_Ubah_di" bpmnElement="Flow_TC_Gw_Ubah">
        <di:waypoint x="400" y="350"/>
        <di:waypoint x="260" y="350"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="332" width="80" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Gw_Void_di" bpmnElement="Flow_TC_Gw_Void">
        <di:waypoint x="440" y="390"/>
        <di:waypoint x="440" y="470"/>
        <di:waypoint x="430" y="470"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="455" y="420" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Gw_Hapus_di" bpmnElement="Flow_TC_Gw_Hapus">
        <di:waypoint x="480" y="350"/>
        <di:waypoint x="540" y="350"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="332" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Yakin_Ya_di" bpmnElement="Flow_TC_Yakin_Ya">
        <di:waypoint x="620" y="350"/>
        <di:waypoint x="690" y="350"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="332" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Yakin_Tidak_di" bpmnElement="Flow_TC_Yakin_Tidak">
        <di:waypoint x="580" y="310"/>
        <di:waypoint x="780" y="286"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="288" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Ubah_End_di" bpmnElement="Flow_TC_Ubah_End">
        <di:waypoint x="170" y="410"/>
        <di:waypoint x="170" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Void_End_di" bpmnElement="Flow_TC_Void_End">
        <di:waypoint x="340" y="550"/>
        <di:waypoint x="340" y="630"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TC_Hapus_End_di" bpmnElement="Flow_TC_Hapus_End">
        <di:waypoint x="780" y="410"/>
        <di:waypoint x="780" y="470"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
