<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_FinancialReports"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- PRODUK 7: LAPORAN KEUANGAN (Reports) — 2 business processes -->

  <!-- ============ BP 7A: MENYUSUN LAPORAN KEUANGAN ============ -->
  <bpmn:process id="Process_Rep_Build" name="Menyusun Laporan Keuangan" isExecutable="false">
    <bpmn:documentation>Proses menyusun laporan keuangan pada GnuCash: memilih jenis laporan dan periode, mengatur opsi, hingga sistem menghitung dan merender laporan.</bpmn:documentation>

    <bpmn:startEvent id="Start_RepB" name="Permintaan laporan keuangan">
      <bpmn:outgoing>Flow_RB_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_RB_T1" name="Memilih jenis laporan &amp; periode">
      <bpmn:incoming>Flow_RB_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_RB_T1_T2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RB_T2" name="Mengatur opsi laporan (basis kas/akrual, detail)">
      <bpmn:incoming>Flow_RB_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_RB_T2_Svc</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_RB_Svc" name="Sistem menghitung &amp; merender laporan">
      <bpmn:incoming>Flow_RB_T2_Svc</bpmn:incoming>
      <bpmn:outgoing>Flow_RB_Svc_Gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_RB_Benar" name="Laporan benar &amp; sesuai?">
      <bpmn:incoming>Flow_RB_Svc_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_RB_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_RB_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RB_Sesuai" name="Menyesuaikan opsi / periode laporan">
      <bpmn:incoming>Flow_RB_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_RB_Sesuai_Svc</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_RB" name="Laporan siap disajikan">
      <bpmn:incoming>Flow_RB_Gw_Ya</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_RB_S_T1" sourceRef="Start_RepB" targetRef="Task_RB_T1"/>
    <bpmn:sequenceFlow id="Flow_RB_T1_T2" sourceRef="Task_RB_T1" targetRef="Task_RB_T2"/>
    <bpmn:sequenceFlow id="Flow_RB_T2_Svc" sourceRef="Task_RB_T2" targetRef="Task_RB_Svc"/>
    <bpmn:sequenceFlow id="Flow_RB_Svc_Gw" sourceRef="Task_RB_Svc" targetRef="Gw_RB_Benar"/>
    <bpmn:sequenceFlow id="Flow_RB_Gw_Ya" name="Ya" sourceRef="Gw_RB_Benar" targetRef="End_RB"/>
    <bpmn:sequenceFlow id="Flow_RB_Gw_Tidak" name="Tidak" sourceRef="Gw_RB_Benar" targetRef="Task_RB_Sesuai"/>
    <bpmn:sequenceFlow id="Flow_RB_Sesuai_Svc" sourceRef="Task_RB_Sesuai" targetRef="Task_RB_Svc"/>
  </bpmn:process>

  <!-- ============ BP 7B: MENGEKSPOR & MEMBAGIKAN LAPORAN ============ -->
  <bpmn:collaboration id="Collab_Rep_Share">
    <bpmn:participant id="Pool_Rep_Staf" name="Staf Keuangan" processRef="Process_Rep_Share"/>
    <bpmn:participant id="Pool_Stake" name="Pemangku Kepentingan" processRef="Process_StakeRecv"/>
    <bpmn:messageFlow id="MF_Rep" name="Laporan" sourceRef="Throw_Rep" targetRef="Start_StakeRecv"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Rep_Share" name="Mengekspor &amp; Membagikan Laporan" isExecutable="false">
    <bpmn:documentation>Proses mengekspor dan membagikan laporan keuangan pada GnuCash ke pihak yang berkepentingan.</bpmn:documentation>

    <bpmn:startEvent id="Start_RepSh" name="Laporan siap dibagikan">
      <bpmn:outgoing>Flow_RS_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_RS_T1" name="Memilih format ekspor (PDF/HTML/CSV)">
      <bpmn:incoming>Flow_RS_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_RS_T1_T2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RS_T2" name="Menyimpan / mencetak laporan">
      <bpmn:incoming>Flow_RS_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_RS_T2_Throw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="Throw_Rep" name="Menyalurkan laporan">
      <bpmn:incoming>Flow_RS_T2_Throw</bpmn:incoming>
      <bpmn:outgoing>Flow_RS_Throw_End</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_RS" name="Laporan dibagikan">
      <bpmn:incoming>Flow_RS_Throw_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_RS_S_T1" sourceRef="Start_RepSh" targetRef="Task_RS_T1"/>
    <bpmn:sequenceFlow id="Flow_RS_T1_T2" sourceRef="Task_RS_T1" targetRef="Task_RS_T2"/>
    <bpmn:sequenceFlow id="Flow_RS_T2_Throw" sourceRef="Task_RS_T2" targetRef="Throw_Rep"/>
    <bpmn:sequenceFlow id="Flow_RS_Throw_End" sourceRef="Throw_Rep" targetRef="End_RS"/>
  </bpmn:process>

  <bpmn:process id="Process_StakeRecv" name="Penerimaan Laporan" isExecutable="false">
    <bpmn:startEvent id="Start_StakeRecv" name="Menerima laporan">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Flow_Stake</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Stake" name="Laporan diterima">
      <bpmn:incoming>Flow_Stake</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Stake" sourceRef="Start_StakeRecv" targetRef="End_Stake"/>
  </bpmn:process>

  <!-- ============ DIAGRAM 7A ============ -->
  <bpmndi:BPMNDiagram id="Diagram_Rep_Build" name="Menyusun Laporan Keuangan">
    <bpmndi:BPMNPlane id="Plane_RB" bpmnElement="Process_Rep_Build">
      <bpmndi:BPMNShape id="Start_RepB_di" bpmnElement="Start_RepB">
        <dc:Bounds x="272" y="60" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RB_T1_di" bpmnElement="Task_RB_T1">
        <dc:Bounds x="200" y="120" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RB_T2_di" bpmnElement="Task_RB_T2">
        <dc:Bounds x="200" y="240" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RB_Svc_di" bpmnElement="Task_RB_Svc">
        <dc:Bounds x="200" y="360" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_RB_Benar_di" bpmnElement="Gw_RB_Benar">
        <dc:Bounds x="250" y="480" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RB_Sesuai_di" bpmnElement="Task_RB_Sesuai">
        <dc:Bounds x="60" y="480" width="160" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RB_di" bpmnElement="End_RB">
        <dc:Bounds x="662" y="502" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_RB_S_T1_di" bpmnElement="Flow_RB_S_T1">
        <di:waypoint x="290" y="96"/>
        <di:waypoint x="290" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_T1_T2_di" bpmnElement="Flow_RB_T1_T2">
        <di:waypoint x="290" y="200"/>
        <di:waypoint x="290" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_T2_Svc_di" bpmnElement="Flow_RB_T2_Svc">
        <di:waypoint x="290" y="320"/>
        <di:waypoint x="290" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_Svc_Gw_di" bpmnElement="Flow_RB_Svc_Gw">
        <di:waypoint x="290" y="440"/>
        <di:waypoint x="290" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_Gw_Ya_di" bpmnElement="Flow_RB_Gw_Ya">
        <di:waypoint x="330" y="520"/>
        <di:waypoint x="600" y="520"/>
        <di:waypoint x="662" y="520"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="500" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_Gw_Tidak_di" bpmnElement="Flow_RB_Gw_Tidak">
        <di:waypoint x="250" y="520"/>
        <di:waypoint x="220" y="520"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="222" y="502" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RB_Sesuai_Svc_di" bpmnElement="Flow_RB_Sesuai_Svc">
        <di:waypoint x="220" y="520"/>
        <di:waypoint x="250" y="520"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- ============ DIAGRAM 7B ============ -->
  <bpmndi:BPMNDiagram id="Diagram_Rep_Share" name="Mengekspor &amp; Membagikan Laporan">
    <bpmndi:BPMNPlane id="Plane_RS" bpmnElement="Collab_Rep_Share">
      <bpmndi:BPMNShape id="Pool_Rep_Staf_di" bpmnElement="Pool_Rep_Staf" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="900" height="440"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_RepSh_di" bpmnElement="Start_RepSh">
        <dc:Bounds x="272" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RS_T1_di" bpmnElement="Task_RS_T1">
        <dc:Bounds x="200" y="150" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RS_T2_di" bpmnElement="Task_RS_T2">
        <dc:Bounds x="200" y="270" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_Rep_di" bpmnElement="Throw_Rep">
        <dc:Bounds x="272" y="390" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RS_di" bpmnElement="End_RS">
        <dc:Bounds x="272" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_Stake_di" bpmnElement="Pool_Stake" isHorizontal="true">
        <dc:Bounds x="40" y="560" width="900" height="140"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_StakeRecv_di" bpmnElement="Start_StakeRecv">
        <dc:Bounds x="272" y="610" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stake_di" bpmnElement="End_Stake">
        <dc:Bounds x="452" y="610" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_RS_S_T1_di" bpmnElement="Flow_RS_S_T1">
        <di:waypoint x="290" y="116"/>
        <di:waypoint x="290" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RS_T1_T2_di" bpmnElement="Flow_RS_T1_T2">
        <di:waypoint x="290" y="230"/>
        <di:waypoint x="290" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RS_T2_Throw_di" bpmnElement="Flow_RS_T2_Throw">
        <di:waypoint x="290" y="350"/>
        <di:waypoint x="290" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RS_Throw_End_di" bpmnElement="Flow_RS_Throw_End">
        <di:waypoint x="290" y="426"/>
        <di:waypoint x="290" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Rep_di" bpmnElement="MF_Rep">
        <di:waypoint x="290" y="506"/>
        <di:waypoint x="290" y="610"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="540" width="60" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stake_di" bpmnElement="Flow_Stake">
        <di:waypoint x="308" y="628"/>
        <di:waypoint x="452" y="628"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
