<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_InvoicingAR"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- PRODUK 4: FAKTUR PENJUALAN & PIUTANG (Invoicing / AR) — 2 business processes -->

  <!-- ============ BP 4A: MEMBUAT & MENGIRIM FAKTUR ============ -->
  <bpmn:process id="Process_AR_Invoice" name="Membuat &amp; Mengirim Faktur" isExecutable="false">
    <bpmn:documentation>Proses membuat faktur penjualan pada GnuCash: menyiapkan pekerjaan, mengisi item faktur, menghitung pajak dan total, kemudian mengirim faktur ke pelanggan.</bpmn:documentation>

    <bpmn:startEvent id="Start_AR_Inv" name="Permintaan faktur penjualan">
      <bpmn:outgoing>Flow_ARI_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ARI_T1" name="Menyiapkan pekerjaan &amp; kontrak pembayaran">
      <bpmn:incoming>Flow_ARI_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_T1_T2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ARI_T2" name="Membuat invoice: pelanggan, tanggal, item">
      <bpmn:incoming>Flow_ARI_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_T2_T3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ARI_T3" name="Mengisi harga, pajak, dan diskon">
      <bpmn:incoming>Flow_ARI_T2_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_T3_Simpan</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ARI_Simpan" name="Sistem menghitung subtotal, pajak &amp; total">
      <bpmn:incoming>Flow_ARI_T3_Simpan</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_Simpan_Gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_ARI_Total" name="Total sesuai?">
      <bpmn:incoming>Flow_ARI_Simpan_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_ARI_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ARI_Kirim" name="Mengirim faktur ke pelanggan (cetak/e-mail)">
      <bpmn:incoming>Flow_ARI_Gw_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_Kirim_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ARI" name="Faktur terkirim">
      <bpmn:incoming>Flow_ARI_Kirim_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_ARI_Betul" name="Memperbaiki item / pajak">
      <bpmn:incoming>Flow_ARI_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_ARI_Betul_Simpan</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ARI_S_T1" sourceRef="Start_AR_Inv" targetRef="Task_ARI_T1"/>
    <bpmn:sequenceFlow id="Flow_ARI_T1_T2" sourceRef="Task_ARI_T1" targetRef="Task_ARI_T2"/>
    <bpmn:sequenceFlow id="Flow_ARI_T2_T3" sourceRef="Task_ARI_T2" targetRef="Task_ARI_T3"/>
    <bpmn:sequenceFlow id="Flow_ARI_T3_Simpan" sourceRef="Task_ARI_T3" targetRef="Task_ARI_Simpan"/>
    <bpmn:sequenceFlow id="Flow_ARI_Simpan_Gw" sourceRef="Task_ARI_Simpan" targetRef="Gw_ARI_Total"/>
    <bpmn:sequenceFlow id="Flow_ARI_Gw_Ya" name="Ya" sourceRef="Gw_ARI_Total" targetRef="Task_ARI_Kirim"/>
    <bpmn:sequenceFlow id="Flow_ARI_Gw_Tidak" name="Tidak" sourceRef="Gw_ARI_Total" targetRef="Task_ARI_Betul"/>
    <bpmn:sequenceFlow id="Flow_ARI_Betul_Simpan" sourceRef="Task_ARI_Betul" targetRef="Task_ARI_Simpan"/>
    <bpmn:sequenceFlow id="Flow_ARI_Kirim_End" sourceRef="Task_ARI_Kirim" targetRef="End_ARI"/>
  </bpmn:process>

  <!-- ============ BP 4B: MENCATAT PEMBAYARAN PELANGGAN ============ -->
  <bpmn:collaboration id="Collab_AR_Pmt">
    <bpmn:participant id="Pool_Customer" name="Pelanggan" processRef="Process_CustPay"/>
    <bpmn:participant id="Pool_AR_Staf" name="Staf Keuangan" processRef="Process_AR_Pmt"/>
    <bpmn:messageFlow id="MF_AR_Pmt" name="Pembayaran" sourceRef="Throw_CustPay" targetRef="Start_AR_Pmt"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustPay" name="Pembayaran Pelanggan" isExecutable="false">
    <bpmn:startEvent id="Start_CustPay" name="Pelanggan membayar">
      <bpmn:outgoing>Flow_CustPay</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Throw_CustPay" name="Kirim pembayaran">
      <bpmn:incoming>Flow_CustPay</bpmn:incoming>
      <bpmn:outgoing>Flow_CustEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_CustPay" name="Pembayaran dikirim">
      <bpmn:incoming>Flow_CustEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CustPay" sourceRef="Start_CustPay" targetRef="Throw_CustPay"/>
    <bpmn:sequenceFlow id="Flow_CustEnd" sourceRef="Throw_CustPay" targetRef="End_CustPay"/>
  </bpmn:process>

  <bpmn:process id="Process_AR_Pmt" name="Mencatat Pembayaran Pelanggan" isExecutable="false">
    <bpmn:documentation>Proses mencatat pembayaran dari pelanggan: membuka invoice terkait, mencatat pembayaran, dan memposting pelunasan penuh atau sebagian.</bpmn:documentation>

    <bpmn:startEvent id="Start_AR_Pmt" name="Menerima pembayaran pelanggan">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Flow_ARP_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ARP_T1" name="Membuka invoice &amp; mencatat pembayaran">
      <bpmn:incoming>Flow_ARP_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_ARP_T1_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_ARP_Lunas" name="Pembayaran penuh?">
      <bpmn:incoming>Flow_ARP_T1_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_ARP_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_ARP_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ARP_Lunas" name="Sistem memposting &amp; menandai invoice lunas">
      <bpmn:incoming>Flow_ARP_Gw_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_ARP_Lunas_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_ARP_Lunas" name="Piutang lunas">
      <bpmn:incoming>Flow_ARP_Lunas_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_ARP_Sebagian" name="Mencatat pembayaran sebagian / uang muka">
      <bpmn:incoming>Flow_ARP_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_ARP_Sebagian_Post</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ARP_Post" name="Sistem memposting pembayaran sebagian">
      <bpmn:incoming>Flow_ARP_Sebagian_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_ARP_Post_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_ARP_Sebagian" name="Piutang berkurang">
      <bpmn:incoming>Flow_ARP_Post_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ARP_T1" sourceRef="Start_AR_Pmt" targetRef="Task_ARP_T1"/>
    <bpmn:sequenceFlow id="Flow_ARP_T1_Gw" sourceRef="Task_ARP_T1" targetRef="Gw_ARP_Lunas"/>
    <bpmn:sequenceFlow id="Flow_ARP_Gw_Ya" name="Ya" sourceRef="Gw_ARP_Lunas" targetRef="Task_ARP_Lunas"/>
    <bpmn:sequenceFlow id="Flow_ARP_Gw_Tidak" name="Tidak (sebagian)" sourceRef="Gw_ARP_Lunas" targetRef="Task_ARP_Sebagian"/>
    <bpmn:sequenceFlow id="Flow_ARP_Lunas_End" sourceRef="Task_ARP_Lunas" targetRef="End_ARP_Lunas"/>
    <bpmn:sequenceFlow id="Flow_ARP_Sebagian_Post" sourceRef="Task_ARP_Sebagian" targetRef="Task_ARP_Post"/>
    <bpmn:sequenceFlow id="Flow_ARP_Post_End" sourceRef="Task_ARP_Post" targetRef="End_ARP_Sebagian"/>
  </bpmn:process>

  <!-- ============ DIAGRAM 4A ============ -->
  <bpmndi:BPMNDiagram id="Diagram_AR_Invoice" name="Membuat &amp; Mengirim Faktur">
    <bpmndi:BPMNPlane id="Plane_ARI" bpmnElement="Process_AR_Invoice">
      <bpmndi:BPMNShape id="Start_AR_Inv_di" bpmnElement="Start_AR_Inv">
        <dc:Bounds x="272" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_T1_di" bpmnElement="Task_ARI_T1">
        <dc:Bounds x="200" y="150" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_T2_di" bpmnElement="Task_ARI_T2">
        <dc:Bounds x="200" y="260" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_T3_di" bpmnElement="Task_ARI_T3">
        <dc:Bounds x="200" y="370" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_Simpan_di" bpmnElement="Task_ARI_Simpan">
        <dc:Bounds x="200" y="500" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ARI_Total_di" bpmnElement="Gw_ARI_Total">
        <dc:Bounds x="250" y="620" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_Kirim_di" bpmnElement="Task_ARI_Kirim">
        <dc:Bounds x="520" y="620" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ARI_di" bpmnElement="End_ARI">
        <dc:Bounds x="592" y="740" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARI_Betul_di" bpmnElement="Task_ARI_Betul">
        <dc:Bounds x="60" y="620" width="150" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ARI_S_T1_di" bpmnElement="Flow_ARI_S_T1">
        <di:waypoint x="290" y="116"/>
        <di:waypoint x="290" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_T1_T2_di" bpmnElement="Flow_ARI_T1_T2">
        <di:waypoint x="290" y="230"/>
        <di:waypoint x="290" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_T2_T3_di" bpmnElement="Flow_ARI_T2_T3">
        <di:waypoint x="290" y="340"/>
        <di:waypoint x="290" y="370"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_T3_Simpan_di" bpmnElement="Flow_ARI_T3_Simpan">
        <di:waypoint x="290" y="450"/>
        <di:waypoint x="290" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_Simpan_Gw_di" bpmnElement="Flow_ARI_Simpan_Gw">
        <di:waypoint x="290" y="580"/>
        <di:waypoint x="290" y="620"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_Gw_Ya_di" bpmnElement="Flow_ARI_Gw_Ya">
        <di:waypoint x="330" y="660"/>
        <di:waypoint x="520" y="660"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="640" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_Gw_Tidak_di" bpmnElement="Flow_ARI_Gw_Tidak">
        <di:waypoint x="250" y="660"/>
        <di:waypoint x="210" y="660"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="212" y="640" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_Betul_Simpan_di" bpmnElement="Flow_ARI_Betul_Simpan">
        <di:waypoint x="210" y="660"/>
        <di:waypoint x="250" y="660"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARI_Kirim_End_di" bpmnElement="Flow_ARI_Kirim_End">
        <di:waypoint x="610" y="700"/>
        <di:waypoint x="610" y="740"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <!-- ============ DIAGRAM 4B ============ -->
  <bpmndi:BPMNDiagram id="Diagram_AR_Pmt" name="Mencatat Pembayaran Pelanggan">
    <bpmndi:BPMNPlane id="Plane_ARP" bpmnElement="Collab_AR_Pmt">
      <bpmndi:BPMNShape id="Pool_Customer_di" bpmnElement="Pool_Customer" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="260" height="620"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_CustPay_di" bpmnElement="Start_CustPay">
        <dc:Bounds x="132" y="120" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_CustPay_di" bpmnElement="Throw_CustPay">
        <dc:Bounds x="152" y="340" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CustPay_di" bpmnElement="End_CustPay">
        <dc:Bounds x="152" y="430" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_AR_Staf_di" bpmnElement="Pool_AR_Staf" isHorizontal="true">
        <dc:Bounds x="360" y="40" width="820" height="620"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_AR_Pmt_di" bpmnElement="Start_AR_Pmt">
        <dc:Bounds x="452" y="120" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARP_T1_di" bpmnElement="Task_ARP_T1">
        <dc:Bounds x="380" y="220" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ARP_Lunas_di" bpmnElement="Gw_ARP_Lunas">
        <dc:Bounds x="430" y="340" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARP_Lunas_di" bpmnElement="Task_ARP_Lunas">
        <dc:Bounds x="700" y="340" width="200" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ARP_Lunas_di" bpmnElement="End_ARP_Lunas">
        <dc:Bounds x="782" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARP_Sebagian_di" bpmnElement="Task_ARP_Sebagian">
        <dc:Bounds x="90" y="340" width="240" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ARP_Post_di" bpmnElement="Task_ARP_Post">
        <dc:Bounds x="90" y="470" width="240" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ARP_Sebagian_di" bpmnElement="End_ARP_Sebagian">
        <dc:Bounds x="192" y="600" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_CustPay_di" bpmnElement="Flow_CustPay">
        <di:waypoint x="170" y="156"/>
        <di:waypoint x="170" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CustEnd_di" bpmnElement="Flow_CustEnd">
        <di:waypoint x="170" y="376"/>
        <di:waypoint x="170" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_AR_Pmt_di" bpmnElement="MF_AR_Pmt">
        <di:waypoint x="188" y="358"/>
        <di:waypoint x="452" y="138"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="230" width="90" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_T1_di" bpmnElement="Flow_ARP_T1">
        <di:waypoint x="470" y="156"/>
        <di:waypoint x="470" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_T1_Gw_di" bpmnElement="Flow_ARP_T1_Gw">
        <di:waypoint x="470" y="300"/>
        <di:waypoint x="470" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_Gw_Ya_di" bpmnElement="Flow_ARP_Gw_Ya">
        <di:waypoint x="510" y="380"/>
        <di:waypoint x="700" y="380"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="360" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_Gw_Tidak_di" bpmnElement="Flow_ARP_Gw_Tidak">
        <di:waypoint x="430" y="380"/>
        <di:waypoint x="330" y="380"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="340" y="360" width="90" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_Lunas_End_di" bpmnElement="Flow_ARP_Lunas_End">
        <di:waypoint x="800" y="420"/>
        <di:waypoint x="800" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_Sebagian_Post_di" bpmnElement="Flow_ARP_Sebagian_Post">
        <di:waypoint x="210" y="420"/>
        <di:waypoint x="210" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ARP_Post_End_di" bpmnElement="Flow_ARP_Post_End">
        <di:waypoint x="210" y="550"/>
        <di:waypoint x="210" y="600"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
