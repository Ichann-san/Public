<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Reconciliation"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- PRODUK 3: REKONSILIASI BANK — 1 business process (kolaborasi Bank-Staf) -->

  <bpmn:collaboration id="Collab_Recon">
    <bpmn:participant id="Pool_Staf" name="Staf Keuangan" processRef="Process_Recon"/>
    <bpmn:participant id="Pool_Bank" name="Bank" processRef="Process_ReconBank"/>
    <bpmn:messageFlow id="MF_Recon" name="Laporan bank (mutasi &amp; saldo)" sourceRef="Throw_Stmt" targetRef="Start_Recon"/>
  </bpmn:collaboration>

  <!-- Proses Bank (pengirim pesan) -->
  <bpmn:process id="Process_ReconBank" name="Laporan Bank" isExecutable="false">
    <bpmn:startEvent id="Start_Bank" name="Bank menyiapkan laporan">
      <bpmn:outgoing>Flow_ReconBank</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Throw_Stmt" name="Mengirim laporan bank">
      <bpmn:incoming>Flow_ReconBank</bpmn:incoming>
      <bpmn:outgoing>Flow_BankEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Bank" name="Laporan bank terkirim">
      <bpmn:incoming>Flow_BankEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReconBank" sourceRef="Start_Bank" targetRef="Throw_Stmt"/>
    <bpmn:sequenceFlow id="Flow_BankEnd" sourceRef="Throw_Stmt" targetRef="End_Bank"/>
  </bpmn:process>

  <!-- Proses Staf Keuangan -->
  <bpmn:process id="Process_Recon" name="Melakukan Rekonsiliasi Bank" isExecutable="false">
    <bpmn:documentation>Proses merekonsiliasi catatan GnuCash dengan laporan bank: menerima laporan, mencocokkan transaksi, memverifikasi saldo, dan menuntaskan selisih bila ada.</bpmn:documentation>

    <bpmn:startEvent id="Start_Recon" name="Menerima laporan bank">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Flow_Recon_S_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Recon_T1" name="Membuka dialog rekonsiliasi &amp; memilih akun">
      <bpmn:incoming>Flow_Recon_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_T1_T2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Recon_T2" name="Mencocokkan transaksi dengan laporan bank">
      <bpmn:incoming>Flow_Recon_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_T2_T3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Recon_T3" name="Memverifikasi saldo akhir">
      <bpmn:incoming>Flow_Recon_T2_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_T3_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_Recon_Cocok" name="Saldo cocok?">
      <bpmn:incoming>Flow_Recon_T3_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_Gw_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_Recon_Gw_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Recon_Selesai" name="Menyelesaikan rekonsiliasi &amp; mengunci">
      <bpmn:incoming>Flow_Recon_Gw_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_Selesai_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Recon" name="Rekonsiliasi selesai">
      <bpmn:incoming>Flow_Recon_Selesai_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Recon_Analisis" name="Menganalisis penyebab selisih">
      <bpmn:incoming>Flow_Recon_Gw_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_Analisis_Meny</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Recon_Menyesuaikan" name="Menyesuaikan penanda / menambah transaksi">
      <bpmn:incoming>Flow_Recon_Analisis_Meny</bpmn:incoming>
      <bpmn:outgoing>Flow_Recon_Meny_T3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:dataObject id="Data_Recon_Stmt" name="Laporan bank"/>
    <bpmn:dataObjectReference id="DataRef_Recon_Stmt" name="Laporan bank" dataObjectRef="Data_Recon_Stmt"/>

    <bpmn:sequenceFlow id="Flow_Recon_S_T1" sourceRef="Start_Recon" targetRef="Task_Recon_T1"/>
    <bpmn:sequenceFlow id="Flow_Recon_T1_T2" sourceRef="Task_Recon_T1" targetRef="Task_Recon_T2"/>
    <bpmn:sequenceFlow id="Flow_Recon_T2_T3" sourceRef="Task_Recon_T2" targetRef="Task_Recon_T3"/>
    <bpmn:sequenceFlow id="Flow_Recon_T3_Gw" sourceRef="Task_Recon_T3" targetRef="Gw_Recon_Cocok"/>
    <bpmn:sequenceFlow id="Flow_Recon_Gw_Ya" name="Ya" sourceRef="Gw_Recon_Cocok" targetRef="Task_Recon_Selesai"/>
    <bpmn:sequenceFlow id="Flow_Recon_Gw_Tidak" name="Tidak" sourceRef="Gw_Recon_Cocok" targetRef="Task_Recon_Analisis"/>
    <bpmn:sequenceFlow id="Flow_Recon_Selesai_End" sourceRef="Task_Recon_Selesai" targetRef="End_Recon"/>
    <bpmn:sequenceFlow id="Flow_Recon_Analisis_Meny" sourceRef="Task_Recon_Analisis" targetRef="Task_Recon_Menyesuaikan"/>
    <bpmn:sequenceFlow id="Flow_Recon_Meny_T3" sourceRef="Task_Recon_Menyesuaikan" targetRef="Task_Recon_T3"/>

    <bpmn:association id="Assoc_Recon" sourceRef="Task_Recon_T2" targetRef="DataRef_Recon_Stmt"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Recon" name="Melakukan Rekonsiliasi Bank">
    <bpmndi:BPMNPlane id="Plane_Recon" bpmnElement="Collab_Recon">
      <!-- Bank pool -->
      <bpmndi:BPMNShape id="Pool_Bank_di" bpmnElement="Pool_Bank" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="760" height="140"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Bank_di" bpmnElement="Start_Bank">
        <dc:Bounds x="102" y="92" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_Stmt_di" bpmnElement="Throw_Stmt">
        <dc:Bounds x="102" y="170" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Bank_di" bpmnElement="End_Bank">
        <dc:Bounds x="220" y="170" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <!-- Staf pool -->
      <bpmndi:BPMNShape id="Pool_Staf_di" bpmnElement="Pool_Staf" isHorizontal="true">
        <dc:Bounds x="40" y="240" width="900" height="640"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Recon_di" bpmnElement="Start_Recon">
        <dc:Bounds x="102" y="300" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_T1_di" bpmnElement="Task_Recon_T1">
        <dc:Bounds x="200" y="300" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_T2_di" bpmnElement="Task_Recon_T2">
        <dc:Bounds x="200" y="420" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_T3_di" bpmnElement="Task_Recon_T3">
        <dc:Bounds x="200" y="540" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Recon_Cocok_di" bpmnElement="Gw_Recon_Cocok">
        <dc:Bounds x="250" y="660" width="80" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_Selesai_di" bpmnElement="Task_Recon_Selesai">
        <dc:Bounds x="520" y="660" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Recon_di" bpmnElement="End_Recon">
        <dc:Bounds x="592" y="790" width="36" height="36"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_Analisis_di" bpmnElement="Task_Recon_Analisis">
        <dc:Bounds x="60" y="660" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recon_Menyesuaikan_di" bpmnElement="Task_Recon_Menyesuaikan">
        <dc:Bounds x="60" y="780" width="180" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataRef_Recon_Stmt_di" bpmnElement="DataRef_Recon_Stmt">
        <dc:Bounds x="440" y="420" width="100" height="60"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <!-- edges -->
      <bpmndi:BPMNEdge id="Flow_ReconBank_di" bpmnElement="Flow_ReconBank">
        <di:waypoint x="120" y="128"/>
        <di:waypoint x="120" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BankEnd_di" bpmnElement="Flow_BankEnd">
        <di:waypoint x="138" y="188"/>
        <di:waypoint x="220" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Recon_di" bpmnElement="MF_Recon">
        <di:waypoint x="120" y="206"/>
        <di:waypoint x="120" y="300"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="240" width="150" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_S_T1_di" bpmnElement="Flow_Recon_S_T1">
        <di:waypoint x="138" y="318"/>
        <di:waypoint x="200" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_T1_T2_di" bpmnElement="Flow_Recon_T1_T2">
        <di:waypoint x="290" y="380"/>
        <di:waypoint x="290" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_T2_T3_di" bpmnElement="Flow_Recon_T2_T3">
        <di:waypoint x="290" y="500"/>
        <di:waypoint x="290" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_T3_Gw_di" bpmnElement="Flow_Recon_T3_Gw">
        <di:waypoint x="290" y="620"/>
        <di:waypoint x="290" y="660"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_Gw_Ya_di" bpmnElement="Flow_Recon_Gw_Ya">
        <di:waypoint x="330" y="700"/>
        <di:waypoint x="520" y="700"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="682" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_Gw_Tidak_di" bpmnElement="Flow_Recon_Gw_Tidak">
        <di:waypoint x="250" y="700"/>
        <di:waypoint x="240" y="700"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="682" width="40" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_Selesai_End_di" bpmnElement="Flow_Recon_Selesai_End">
        <di:waypoint x="610" y="740"/>
        <di:waypoint x="610" y="790"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_Analisis_Meny_di" bpmnElement="Flow_Recon_Analisis_Meny">
        <di:waypoint x="150" y="740"/>
        <di:waypoint x="150" y="780"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Recon_Meny_T3_di" bpmnElement="Flow_Recon_Meny_T3">
        <di:waypoint x="240" y="800"/>
        <di:waypoint x="600" y="800"/>
        <di:waypoint x="600" y="560"/>
        <di:waypoint x="380" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_Recon_di" bpmnElement="Assoc_Recon">
        <di:waypoint x="440" y="460"/>
        <di:waypoint x="380" y="460"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
